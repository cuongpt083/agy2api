# AGY2API Configuration

# API Security Key
AGY_API_KEY=your-secret-key-here

# Warm Spare Process Pool (Performance Optimization)
# Set to 0 to completely disable process pool (fallback to cold spawn per request)
AGY_POOL_SIZE=1

# Default model used for pre-warming on startup if AGY_POOL_MODELS is not set
AGY_DEFAULT_MODEL=gemini-3.8-flash-high

# Comma-separated list of models to pre-warm on server startup
# Example: AGY_POOL_MODELS=gemini-3.8-flash-high,gemini-3.8-flash-low
AGY_POOL_MODELS=gemini-3.8-flash-high

# Dynamic Auto-Warm: When a user calls a model not currently in the pool,
# the system automatically pre-warms a worker for that model for subsequent requests.
# Maximum number of different models kept warm simultaneously (evicts least-recently-used):
AGY_POOL_MAX_DYNAMIC_MODELS=3
