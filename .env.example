# AGY2API Configuration

# API Security Key
AGY_API_KEY=your-secret-key-here

# Capture LLM turns to SQLite database (Background Data Logging)
# Set to 'false' (or 0) to completely disable capturing turns to SQLite database
# Set to 'true' (or 1) to enable background capture (default: true)
CAPTURE_ENABLED=true
# Path to SQLite capture database (default: data/capture.db)
# CAPTURE_DB_PATH=data/capture.db

# Warm Spare Process Pool (Performance Optimization)
# Set to 0 to completely disable process pool (fallback to cold spawn per request)
# Use >=2 if OpenClaw (or any client) fires parallel requests; size=1 still cold-spawns the 2nd call.
AGY_POOL_SIZE=2

# Default model used for pre-warming on startup if AGY_POOL_MODELS is not set
AGY_DEFAULT_MODEL=gemini-3.8-flash-high

# Comma-separated list of models to pre-warm on server startup.
# Each model is warmed twice (plain + tools schema). Include the ids OpenClaw actually sends
# (e.g. gemini-3.8-flash-medium), not only the display/high variant, or the pool never hits.
# Example: AGY_POOL_MODELS=gemini-3.8-flash-high,gemini-3.8-flash-medium,gemini-3.8-flash-low
AGY_POOL_MODELS=gemini-3.8-flash-high,gemini-3.8-flash-medium

# Dynamic Auto-Warm: When a user calls a model not currently in the pool,
# the system automatically pre-warms a worker for that model for subsequent requests.
# Counted in model||flavor keys (plain + tools). Default 6 ≈ 3 models.
AGY_POOL_MAX_DYNAMIC_MODELS=6

# Discard warm workers older than this many seconds (stale OAuth/eligibility risk).
AGY_POOL_MAX_WORKER_AGE_SECONDS=900

# Per-turn wall clock in seconds for warm/cold stream-json reads (Python deadline).
AGY_TURN_TIMEOUT_SECONDS=600

# Run agy inside bubblewrap (hides project source/.env, own PID namespace, cleared env). Off by default.
# AGY_SANDBOX=bwrap
# Abort tools-emulation turns after this many agy built-in tool steps (0 = disable)
# AGY_MAX_BUILTIN_TOOL_STEPS=3
